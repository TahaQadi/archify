      "ownerRole": "warehouse",
      "appliesTo": [
        "order_to_delivery.verify"
      ],
      "evidence": "Picker and verifier identity with timestamps",
      "status": "proposed"
    },
    {
      "id": "porelease",
      "name": "Release before dispatch",
      "ownerRole": "finance",
      "appliesTo": [
        "order_to_delivery.release"
      ],
      "evidence": "Recorded approval or documented exception",
      "status": "client-decision"
    }
  ],
  "processes": [
    {
      "id": "order_to_delivery",
      "name": "Customer order → proof of delivery",
      "capability": "fulfillment",
      "ownerRole": "warehouse",
      "status": "proposed",
      "phases": [
        {
          "id": "intake",
          "name": "Request"
        },
        {
          "id": "allocate",
          "name": "Allocation"
        },
        {
          "id": "picking",
          "name": "Picking"
        },
        {
          "id": "check",
          "name": "Verification"
        },
        {
          "id": "dispatch",
          "name": "Dispatch"
        },
        {
          "id": "complete",
          "name": "Completion"
        }
      ],
      "steps": [
        {
          "id": "capture",
          "name": "Record customer request",
          "phase": "intake",
          "role": "sales",
          "system": "erpnext",
          "inputs": [
            "request"
          ],
          "outputs": [],
          "permissions": [
            "order_read"
          ],
          "status": "proposed"
        },
        {
          "id": "allocate",
          "name": "Check and allocate stock",
          "phase": "allocate",
          "role": "warehouse",
          "location": "main_wh",
          "system": "erpnext",
          "inputs": [
            "stock"
          ],
          "permissions": [
            "stock_read"
          ],
          "status": "proposed"
        },
        {
          "id": "shortage",
          "name": "Request replenishment",
          "phase": "allocate",
          "role": "warehouse",
          "location": "main_wh",
          "system": "erpnext",
          "kind": "decision",
          "permissions": [
            "stock_request"
          ],
          "status": "proposed"
        },
        {
          "id": "pick",
          "name": "Pick ordered items",
          "phase": "picking",
          "role": "picker",
          "location": "main_wh",
          "system": "erpnext",
          "outputs": [
            "picklist"
          ],
          "permissions": [
            "pick_execute"
          ],
          "status": "proposed"
        },
        {
          "id": "verify",
          "name": "Verify quantities and items",
          "phase": "check",
          "role": "warehouse",
          "location": "main_wh",
          "system": "erpnext",
          "inputs": [
            "picklist"
          ],
          "controls": [
            "verify_pick"
          ],
          "permissions": [
            "pick_verify"
          ],
          "status": "proposed"
        },
        {
          "id": "release",
          "name": "Approve release to dispatch",
          "phase": "dispatch",
          "role": "finance",
          "system": "erpnext",
          "kind": "decision",
          "outputs": [
            "delivery"
          ],
          "controls": [
            "porelease"
          ],
          "permissions": [
            "release_order"
          ],
          "status": "client-decision"
        },
        {
          "id": "deliver",
          "name": "Deliver and capture receipt",
          "phase": "dispatch",
          "role": "driver",
          "location": "customer",
          "system": "erpnext",
          "inputs": [
            "delivery"
          ],
          "outputs": [
            "proof"
          ],
          "permissions": [
            "delivery_update"
          ],
          "status": "proposed"
        },
        {
          "id": "close",
          "name": "Close delivery loop",
          "phase": "complete",
          "role": "sales",
          "system": "erpnext",
          "inputs": [
            "proof"
          ],
          "permissions": [
            "closure"
          ],
          "status": "proposed"
        }
      ],
      "flows": [
        {
          "from": "capture",
          "to": "allocate"
        },
        {
          "from": "allocate",
          "to": "pick",
          "condition": "Stock available"
        },
        {
          "from": "allocate",
          "to": "shortage",
          "kind": "exception",
          "condition": "Shortage"
        },
        {
          "from": "shortage",
          "to": "allocate",
          "kind": "branch",
          "condition": "After replenishment"
        },
        {
          "from": "pick",
          "to": "verify"
        },
        {
          "from": "verify",
          "to": "release"
        },
        {
          "from": "release",
          "to": "deliver"
        },
        {
          "from": "deliver",
          "to": "close"
        }
      ],
      "mainPath": [
        "capture",
        "allocate",
        "pick",
        "verify",
        "release",
        "deliver",
        "close"
      ],
