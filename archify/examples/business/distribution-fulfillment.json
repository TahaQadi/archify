          ],
          "consulted": [],
          "informed": [
            "sales"
          ]
        },
        {
          "step": "shortage",
          "accountable": "warehouse",
          "responsible": [
            "warehouse"
          ],
          "consulted": [
            "sales"
          ],
          "informed": []
        },
        {
          "step": "pick",
          "accountable": "warehouse",
          "responsible": [
            "picker"
          ],
          "consulted": [],
          "informed": []
        },
        {
          "step": "verify",
          "accountable": "warehouse",
          "responsible": [
            "warehouse"
          ],
          "consulted": [],
          "informed": [
            "sales"
          ]
        },
        {
          "step": "release",
          "accountable": "finance",
          "responsible": [
            "finance"
          ],
          "consulted": [
            "warehouse"
          ],
          "informed": [
            "driver"
          ]
        },
        {
          "step": "deliver",
          "accountable": "warehouse",
          "responsible": [
            "driver"
          ],
          "consulted": [],
          "informed": [
            "sales"
          ]
        },
        {
          "step": "close",
          "accountable": "sales",
          "responsible": [
            "sales"
          ],
          "consulted": [],
          "informed": [
            "warehouse"
          ]
        }
      ]
    }
  ],
  "decisions": [
