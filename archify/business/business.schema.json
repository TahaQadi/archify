{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archify:business-model:1",
  "title": "Archify Business Operating Model Studio · source model",
  "description": "Business model contract. Referential integrity and single-accountable RACI are additionally checked by model.mjs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "description": {
      "type": "string"
    },
    "valueProposition": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "suppliers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "information": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "managementSystems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        }
      },
      "required": []
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "person": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "location": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "required": [
          "person",
          "role"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "system": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scope": {
            "type": "string"
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "approverRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "required": [
          "id",
          "role",
          "resource",
          "actions",
          "status"
        ]
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "ownerRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "appliesTo": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "required": [
          "id",
          "name",
          "ownerRole",
          "status"
        ]
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "ownerRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "name"
              ]
            }
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "phase": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "role": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "location": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "system": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "kind": {
                  "enum": [
                    "activity",
                    "decision",
                    "record",
                    "message",
                    "external"
                  ]
                },
                "inputs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                },
                "outputs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                },
                "controls": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                },
                "permissions": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                },
                "status": {
                  "$ref": "#/$defs/status"
                }
              },
              "required": [
                "id",
                "name",
                "phase",
                "role",
                "status"
              ]
            }
          },
          "flows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "condition": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "standard",
                    "branch",
                    "exception"
                  ]
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          },
          "mainPath": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            }
          },
          "raci": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "step": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "accountable": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                "responsible": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                },
                "consulted": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                },
                "informed": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                  }
                }
              },
              "required": [
                "step",
                "accountable",
                "responsible"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "ownerRole",
          "status",
          "phases",
          "steps",
          "flows",
          "mainPath",
          "raci"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "proposerRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "approverRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "backupRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "rule": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "required": [
          "id",
          "name",
          "process",
          "proposerRole",
          "approverRole",
          "status"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "ownerRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "definition": {
            "type": "string"
          },
          "target": {
            "type": [
              "number",
              "string"
            ]
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "required": [
          "id",
          "name",
          "process",
          "ownerRole",
          "status"
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "ownerRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "likelihood": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "treatment": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "required": [
          "id",
          "name",
          "process",
          "ownerRole",
          "status"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "ownerRole": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "acceptanceCriteria": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        },
        "required": [
          "id",
          "description",
          "status"
        ]
      }
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "valueProposition",
    "entities",
    "processes"
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "proposed",
        "client-decision",
        "assumed-for-workshop",
        "new"
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ]
    }
  }
}
